---
import BaseLayout from "./BaseLayout.astro";
import Tag from "../components/Tag.astro";
import { site } from "../config/site";
import { formatDate, readingMinutes, type BlogPost } from "../lib/blog";
interface Props {
  post: BlogPost;
  previous?: BlogPost;
  next?: BlogPost;
}
const { post, previous, next } = Astro.props;
---

<BaseLayout
  title={`${post.data.title} — ${site.name}`}
  description={post.data.description}
  type="article"
>
  <div class="shell article-shell">
    <a class="back-link" href="/blog/">
      ← All writing
    </a>
    <header class="article-header">
      <p class="eyebrow">Writing / {readingMinutes(post)} min read</p>
      <h1>{post.data.title}</h1>
      <p class="article-dek">{post.data.description}</p>
      <div class="article-dates">
        <time datetime={post.data.date.toISOString()}>
          Published {formatDate(post.data.date, post.data.datePrecision)}
        </time>
        {post.data.updated && (
          <span>
            Updated{" "}
            <time datetime={post.data.updated.toISOString()}>
              {formatDate(post.data.updated)}
            </time>
          </span>
        )}
      </div>
      <div class="tags">
        {post.data.tags.map((tag) => (
          <Tag label={tag} />
        ))}
      </div>
    </header>
    <article class="prose">
      <slot />
    </article>
    <nav class="article-pagination" aria-label="Article navigation">
      {previous ? (
        <a href={`/blog/${previous.id}/`}>
          <span>← Older article</span>
          <strong>{previous.data.title}</strong>
        </a>
      ) : (
        <span></span>
      )}
      {next && (
        <a href={`/blog/${next.id}/`}>
          <span>Newer article →</span>
          <strong>{next.data.title}</strong>
        </a>
      )}
    </nav>
  </div>
</BaseLayout>
