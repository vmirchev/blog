---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/BlogCard.astro";
import { getPublishedPosts } from "../../lib/blog";
import { site } from "../../config/site";
const posts = await getPublishedPosts();
---

<BaseLayout
  title={`Writing — ${site.name}`}
  description="Stories and lessons from building software, games, and machine learning projects."
>
  <div class="shell page-shell">
    <div class="page-intro">
      <p class="eyebrow">Writing / Learning in public</p>
      <h1>What I learned by building.</h1>
      <p>
        Stories from software development, games, and machine learning: the
        projects I built, the mistakes I investigated, and the lessons that
        stayed with me.
      </p>
    </div>
    <div class="blog-list blog-index">
      {posts.map((post) => (
        <BlogCard post={post} />
      ))}
    </div>
  </div>
</BaseLayout>
